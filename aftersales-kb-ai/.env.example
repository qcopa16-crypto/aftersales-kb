# ===== Internal security =====
# Must match Java ai.internal-token in production
INTERNAL_TOKEN=change-me-long-random

# ===== Embedding: local | cloud | fake =====
EMBED_PROVIDER=local
EMBED_LOCAL_MODEL=BAAI/bge-m3
EMBED_LOCAL_DEVICE=cpu
# EMBED_CLOUD_BASE=https://api.siliconflow.cn/v1
# EMBED_CLOUD_KEY=sk-xxx
# EMBED_CLOUD_MODEL=BAAI/bge-m3
EMBED_DIM=1024
EMBED_BATCH_SIZE=16

# ===== Vector store: milvus | memory =====
VECTOR_STORE=memory
MILVUS_URI=http://127.0.0.1:19530
MILVUS_COLLECTION=kb_chunks

# ===== MinerU (PDF parse) =====
MINERU_ENABLED=false
MINERU_TOKEN=
MINERU_API_BASE=https://mineru.net

# ===== LLM (cloud only) =====
LLM_API_BASE=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=
LLM_MODEL=glm-4.5-air
LLM_TEMPERATURE=0.2

# ===== VLM (cloud only) =====
VLM_ENABLED=false
VLM_API_BASE=https://open.bigmodel.cn/api/paas/v4
VLM_API_KEY=
VLM_MODEL=glm-4.6v

# ===== Server =====
HOST=0.0.0.0
PORT=8000

# ===== Stateless hardening =====
# Sync parse wall-clock budget (seconds); 0 disables. Stage timeouts: SOURCE_*, MINERU_POLL_*, VLM_*
PARSE_OVERALL_TIMEOUT_SEC=900
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_COOLDOWN_SEC=60

# ===== Input hardening =====
EMBED_MAX_CHUNKS=5000
MAX_MARKDOWN_CHARS=200000
GENERATE_MAX_QUESTION_CHARS=2000
GENERATE_MAX_CONTEXTS_TOTAL_CHARS=120000
ERROR_MESSAGE_MAX_CHARS=500
# /metrics requires X-Internal-Token unless true (debug only)
METRICS_PUBLIC=false
# Fail startup when INTERNAL_TOKEN is empty or the documented default
REFUSE_ON_DEFAULT_INTERNAL_TOKEN=false

# ===== Hybrid retrieve (dense + lexical + RRF) =====
RETRIEVE_HYBRID_ENABLED=true
RETRIEVE_HYBRID_RRF_K=60
RETRIEVE_HYBRID_DEGRADE_TO_DENSE=true
RETRIEVE_HYBRID_LEXICAL_MODE=memory_bm25
RETRIEVE_OVERFETCH_FACTOR=3
RETRIEVE_OVERFETCH_MAX=50
RETRIEVE_MAX_PER_UNIT=2
RETRIEVE_MAX_QUESTION_CHARS=2000
RETRIEVE_ENABLE_RERANK=false
# Production REQUIRED: require Java-resolved acl_filter on every retrieve
RETRIEVE_REQUIRE_ACL=false
# Production: refuse startup when retrieve_require_acl=false
RETRIEVE_STRICT_PROD=false
# Production: reject embed without acl_department (after Java always sends it)
EMBED_REQUIRE_ACL_FIELDS=false
# Single-writer JSON for Milvus active versions (survives process restart)
MILVUS_ACTIVE_MAP_PATH=.data/milvus_active_versions.json
# Soft wall-clock for dense store.search (0 = disabled)
RETRIEVE_STORE_TIMEOUT_SEC=5
# Full retrieve pipeline budget (0 = disabled); on exceed → 504 RETRIEVE_TIMEOUT
RETRIEVE_OVERALL_TIMEOUT_SEC=8
# Cap docs scored by lexical path in stable order
RETRIEVE_LEXICAL_MAX_DOCS=5000
# Skip lexical entirely when doc_count exceeds cap (default: score first N)
RETRIEVE_LEXICAL_SKIP_WHEN_OVER_CAP=false
# Production multi-replica: dense-only (process-local lexical/active map unsafe)
RETRIEVE_MULTI_REPLICA_SAFE=false
# Bulkhead around full retrieve (0 = disabled); full → 429 RATE_LIMIT
RETRIEVE_MAX_CONCURRENCY=32
# Process-local QPS for retrieve (0 = disabled); over → 429 RATE_LIMIT
RETRIEVE_QPS_LIMIT=0
# Shared store.search soft-timeout pool size
RETRIEVE_STORE_POOL_SIZE=4
# Cold-start lexical sync budget (0 = follow RETRIEVE_STORE_TIMEOUT_SEC)
RETRIEVE_LEXICAL_SYNC_TIMEOUT_SEC=0
# Max unit_ids / deny_unit_ids list length on retrieve
RETRIEVE_MAX_UNIT_IDS=500
# Drop hits missing required ACL metadata when filter demands dept/classification
RETRIEVE_ACL_FIELDS_REQUIRED=false
# Structured JSON log line per retrieve (q_hash + stage_ms; no question text)
RETRIEVE_STRUCT_LOG=true
# Query embedding process-local LRU (0 = disabled)
RETRIEVE_EMBED_CACHE_MAX=0
