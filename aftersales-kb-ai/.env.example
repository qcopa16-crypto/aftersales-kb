# ===== Internal security =====
# Must match Java ai.internal-token in production
INTERNAL_TOKEN=change-me-long-random

# ===== Embedding: local | cloud | fake =====
EMBED_PROVIDER=local
EMBED_LOCAL_MODEL=BAAI/bge-m3
EMBED_LOCAL_DEVICE=cpu
# EMBED_CLOUD_BASE=https://api.siliconflow.cn/v1
# EMBED_CLOUD_KEY=sk-xxx
# EMBED_CLOUD_MODEL=BAAI/bge-m3
EMBED_DIM=1024
EMBED_BATCH_SIZE=16

# ===== Vector store: milvus | memory =====
VECTOR_STORE=memory
MILVUS_URI=http://127.0.0.1:19530
MILVUS_COLLECTION=kb_chunks

# ===== MinerU (PDF parse) =====
MINERU_ENABLED=false
MINERU_TOKEN=
MINERU_API_BASE=https://mineru.net

# ===== LLM (cloud only) =====
LLM_API_BASE=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=
LLM_MODEL=glm-4.5-air
LLM_TEMPERATURE=0.2

# ===== VLM (cloud only) =====
VLM_ENABLED=false
VLM_API_BASE=https://open.bigmodel.cn/api/paas/v4
VLM_API_KEY=
VLM_MODEL=glm-4.6v

# ===== Server =====
HOST=0.0.0.0
PORT=8000

# ===== Stateless hardening =====
# Sync parse wall-clock budget (seconds); 0 disables. Stage timeouts: SOURCE_*, MINERU_POLL_*, VLM_*
PARSE_OVERALL_TIMEOUT_SEC=900
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_COOLDOWN_SEC=60

# ===== Input hardening =====
EMBED_MAX_CHUNKS=5000
MAX_MARKDOWN_CHARS=200000
GENERATE_MAX_QUESTION_CHARS=2000
GENERATE_MAX_CONTEXTS_TOTAL_CHARS=120000
ERROR_MESSAGE_MAX_CHARS=500
# /metrics requires X-Internal-Token unless true (debug only)
METRICS_PUBLIC=false
# Fail startup when INTERNAL_TOKEN is empty or the documented default
REFUSE_ON_DEFAULT_INTERNAL_TOKEN=false
