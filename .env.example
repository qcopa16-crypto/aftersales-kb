# =========================================================
# 环境变量模板（仅占位符，禁止填真实值；本文件可入库）
# 用法：复制为 .env（.env 已被 .gitignore 排除）后填写，
#       或在部署环境中注入同名环境变量。
# =========================================================

# ---------- Java 业务服务 ----------
# HS256 签名密钥：>= 32 字节随机串（openssl rand -base64 48）
JWT_SECRET=__CHANGE_ME__
# Java <-> AI 内部调用令牌：必须与 AI 侧 INTERNAL_TOKEN 完全一致
AI_INTERNAL_TOKEN=__CHANGE_ME__
# MySQL（生产必须启用 TLS + 服务端证书校验；本地可改用 sslMode=DISABLED）
MYSQL_URL=jdbc:mysql://127.0.0.1:3306/aftersales_kb?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai&sslMode=VERIFY_IDENTITY
MYSQL_USER=__CHANGE_ME__
MYSQL_PASSWORD=__CHANGE_ME__
MYSQL_POOL_MAX=10
# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=__CHANGE_ME__
# 服务端口与 AI 地址
SERVER__PORT=8080
AI_BASE_URL=http://127.0.0.1:8000
# 上传并发上限（会按连接池容量自动收敛）
APP_UPLOAD_MAX_CONCURRENT_REQUESTS=4
# 多实例共享卷（单实例保持 false）
APP_STORAGE_MULTI_INSTANCE=false
APP_STORAGE_NODE_ID=
APP_STORAGE_EXPECTED_NODE_IDS=

# ---------- AI 服务 ----------
# 详见 aftersales-kb-ai/.env.example（该目录下的 .env 亦不入库）
INTERNAL_TOKEN=__CHANGE_ME__
MILVUS_URI=http://127.0.0.1:19530
MILVUS_COLLECTION=kb_chunks
MILVUS_ACTIVE_MAP_PATH=.data/milvus_active_versions.json
RETRIEVE_INDEX_REPAIR_PATH=.data/index_repair.json
EMBED_CLOUD_KEY=__CHANGE_ME__
LLM_API_KEY=__CHANGE_ME__
VLM_API_KEY=__CHANGE_ME__
MINERU_TOKEN=__CHANGE_ME__
# 会话记忆（MongoDB，可选）
SESSION_MEMORY_ENABLED=false
SESSION_MONGO_URI=mongodb://127.0.0.1:27017
